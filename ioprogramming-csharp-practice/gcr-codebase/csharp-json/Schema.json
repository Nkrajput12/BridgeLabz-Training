{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "subjects": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [ "name", "email" ]
}